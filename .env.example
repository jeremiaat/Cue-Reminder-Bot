# Required — the Telegram bot token from @BotFather
BOT_TOKEN=123456789:AA...

# ---- Turso (remote database) ----
# Create a DB at https://turso.tech and copy these from the dashboard.
# Required in production. If omitted, the bot falls back to a local
# file:data/reminders.db (dev only).
TURSO_DATABASE_URL=libsql://your-db-org.turso.io
TURSO_AUTH_TOKEN=eyJhbGciOi...

# ---- Vercel Cron ----
# Vercel automatically sends this as `Authorization: Bearer <CRON_SECRET>`
# to the /api/cron endpoint. Set it to a random long string.
CRON_SECRET=replace-with-a-long-random-string

# ---- Webhook (deploy only) ----
# Used by `npm run webhook:set` to point Telegram at your deployed
# endpoint, e.g. https://<your-project>.vercel.app/api/webhook
WEBHOOK_URL=https://your-project.vercel.app/api/webhook
