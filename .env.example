# Required — the Telegram bot token from @BotFather
BOT_TOKEN=123456789:AA...

# ---- Turso (remote database) ----
# Create a DB at https://turso.tech and copy these from the dashboard.
# Required in production.
TURSO_DATABASE_URL=libsql://your-db-org.turso.io
TURSO_AUTH_TOKEN=eyJhbGciOi...

# ---- Vercel (production) ----
# The public HTTPS URL of your Vercel deployment. Used to set the Telegram webhook.
# For cron-jobs.org, add this as the POST URL:
#   https://<your-project>.vercel.app/api/cron
#   Header: Authorization: Bearer <CRON_SECRET>
#   Schedule: every minute (* * * * *)
WEBHOOK_URL=https://<your-project>.vercel.app/api/webhook
CRON_SECRET=please-change-me

# ---- Optional ----
# PORT=8080